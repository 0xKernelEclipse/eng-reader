{
  "name": "English Vocabulary Reader",
  "short_name": "EngReader",
  "description": "Photograph an English textbook page, extract vocabulary words, and listen to them with Arabic meanings offline",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#090f1d",
  "theme_color": "#090f1d",
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
